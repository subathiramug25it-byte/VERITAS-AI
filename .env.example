# VERITAS AI Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Application Settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./veritas_ai.db

# Optional AI / LLM Providers (Leave empty to use deterministic hybrid reasoning engine)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Fact-Check & Search APIs (Optional - system falls back to public retrieval / curated registry)
GOOGLE_FACTCHECK_API_KEY=
SERPAPI_API_KEY=
SEARCH_PROVIDER=duckduckgo  # Options: duckduckgo, serpapi, mock

# Investigation Agent Budget Limits
MAX_INVESTIGATION_STEPS=4
INVESTIGATION_TIMEOUT_SECONDS=45
CONFIDENCE_THRESHOLD=0.75

# Data Retention
STORE_INVESTIGATIONS=True
ALLOW_ANONYMOUS_TELEMETRY=False
